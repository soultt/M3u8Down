{
  "name": "m3u8-down",
  "version": "1.0.1",
  "description": "M3U8 视频多线程下载与 MP4 合并工具",
  "main": "main.js",
  "author": "M3u8Down",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --data-dir=./.appdata",
    "icon": "electron make-icon.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.m3u8down.app",
    "productName": "M3u8Down",
    "executableName": "M3u8Down",
    "copyright": "Copyright © 2026",
    "compression": "normal",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "M3u8Down",
      "artifactName": "M3u8Down-Setup.exe",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "M3u8Down-portable.exe"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
